{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "enableCorepack": true,
  "builds": [
    {
      "src": "server/vercel.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["dist/public/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server/vercel.ts"
    }
  ]
}
